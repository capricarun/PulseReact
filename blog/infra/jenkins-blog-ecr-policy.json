{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrPushOnlyBlogRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:${AWS_ACCOUNT_ID}:repository/blog-backend",
        "arn:aws:ecr:ap-south-1:${AWS_ACCOUNT_ID}:repository/blog-frontend"
      ]
    }
  ]
}
